#!/bin/bash
# Хуки установки пакета cowboy-banner для pacman (AUR).
#
# Вся логика подключения и отключения - в общих хуках, которые кладутся
# в /usr/lib/cowboy-banner/. Те же самые хуки используют пакеты deb и rpm.

begin_marker="# >>> cowboy-banner >>>"
end_marker="# <<< cowboy-banner <<<"

# Каталог с общими хуками. Переопределяется переменной COWBOY_HOOK_DIR -
# так их можно проверять в тестах, не устанавливая пакет.
hook_dir="${COWBOY_HOOK_DIR:-/usr/lib/cowboy-banner}"

post_install() {
    "$hook_dir/install.sh"

    cat <<EOF

  cowboy-banner установлен.

    Текущий терминал:      cowboy-banner
    Меню тем:               COWBOY_BANNER=menu cowboy-banner
    Сменить тему:           export COWBOY_THEME=ocean   (для bash/zsh)
                            \$env:COWBOY_THEME = 'ocean' (PowerShell)
    Выключить совсем:       export COWBOY_BANNER=none
    Подробности:            man cowboy-banner  /  /usr/share/doc/cowboy-banner/README.md

  Подключено: ~/.bashrc, ~/.zshrc, профиль PowerShell
  Бэкапы: *.cowboy-banner.bak (при удалении пакета блоки убираются сами)

EOF
}

pre_remove() {
    "$hook_dir/remove.sh"
    :
}

post_remove() {
    cat <<EOF

  cowboy-banner удалён.

    Настройки убраны из: ~/.bashrc, ~/.zshrc, профиля PowerShell.
    Прежние версии файлов: *.cowboy-banner.bak (если пакет что-то менял).
    Картинки лежат в /usr/share/cowboy-banner - их можно удалить вручную.

EOF
}
